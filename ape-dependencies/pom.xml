<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.apeadmin</groupId>
  <artifactId>ape-dependencies</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>ApeAdmin :: Dependencies (BOM)</name>
  <description>全部依赖版本单点治理（独立 BOM，不继承 root，避免 import 循环）</description>

  <properties>
    <spring-boot.version>3.5.13</spring-boot.version>
    <sa-token.version>1.46.0</sa-token.version>
    <mybatis-plus.version>3.5.18.1</mybatis-plus.version>
    <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
    <flyway.version>12.4.0</flyway.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot BOM -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Sa-Token（Simple JWT 模式，保留踢人/黑名单语义） -->
      <dependency>
        <groupId>cn.dev33</groupId>
        <artifactId>sa-token-spring-boot3-starter</artifactId>
        <version>${sa-token.version}</version>
        <exclusions>
          <!-- SB4 已全面转 Jackson 3（tools.jackson），sa-token 的 Jackson2 插件在 SB4 下缺 jsr310 会启动失败；
               排除后 sa-token 回退 core 内置 JSON 实现（本项目未依赖其复杂 JSON 能力） -->
          <exclusion>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jackson</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>cn.dev33</groupId>
        <artifactId>sa-token-jwt</artifactId>
        <version>${sa-token.version}</version>
      </dependency>
      <!-- framework-web 全局异常层仅需核心包（识别鉴权异常），不引 starter -->
      <dependency>
        <groupId>cn.dev33</groupId>
        <artifactId>sa-token-core</artifactId>
        <version>${sa-token.version}</version>
      </dependency>

      <!-- MyBatis-Plus + JSqlParser 变体（数据权限拦截器） -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-jsqlparser-4.9</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>

      <!-- 数据库驱动（sqlite-jdbc 版本沿用 SB4 BOM 管理值；SQLite 支持内置于 flyway-core） -->
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>

      <!-- 内部模块 -->
      <dependency>
        <groupId>com.apeadmin</groupId>
        <artifactId>ape-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.apeadmin</groupId>
        <artifactId>ape-framework-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.apeadmin</groupId>
        <artifactId>ape-framework-mybatis</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.apeadmin</groupId>
        <artifactId>ape-framework-log</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.apeadmin</groupId>
        <artifactId>ape-framework-redis</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.apeadmin</groupId>
        <artifactId>ape-system</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.apeadmin</groupId>
        <artifactId>ape-chat</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.apeadmin</groupId>
        <artifactId>ape-mcp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.apeadmin</groupId>
        <artifactId>ape-plugin</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
