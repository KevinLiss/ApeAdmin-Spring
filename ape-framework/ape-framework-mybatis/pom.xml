<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.apeadmin</groupId>
    <artifactId>ape-framework</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>ape-framework-mybatis</artifactId>
  <packaging>jar</packaging>
  <name>ApeAdmin :: Framework :: MyBatis</name>
  <description>MP 拦截器链 + 字段自动填充 + data_scope 数据权限</description>

  <dependencies>
    <dependency>
      <groupId>com.apeadmin</groupId>
      <artifactId>ape-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser-4.9</artifactId>
    </dependency>
    <!-- MP 3.5.18 starter 不再传递 spring-boot-starter-jdbc（SB4 模块化），
         缺它则 DataSourceAutoConfiguration/SqlSessionFactory 均不会装配 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- SB4 starter 不再捆绑 AOP：显式引 aspectjweaver（BOM 管版本） -->
    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
